<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pre-Compose window theme (splash/launch background) only; all actual
         theming is Compose Material3 in core/designsystem/Theme.kt. -->
    <style name="Theme.PicklePro" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/pickle_green</item>
        <item name="android:statusBarColor">@color/pickle_green</item>
    </style>

    <!-- Cold-start splash (androidx.core.splashscreen): the launcher icon on
         the brand green background, handing off to Theme.PicklePro once
         MainActivity's first frame is drawn. -->
    <style name="Theme.PicklePro.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pickle_green</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.PicklePro</item>
    </style>
</resources>
